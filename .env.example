# ex-chat 运行环境配置示例
PORT=8080
ENV=development

# 数据库配置（支持 postgres 与 sqlite）
# 本地 Docker PostgreSQL:
DB_DRIVER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-random-password
DB_DSN=host=localhost user=postgres password=replace-with-a-strong-random-password dbname=ex_chat port=55432 sslmode=disable TimeZone=Asia/Shanghai

# SQLite 回退配置:
# DB_DRIVER=sqlite
# DB_PATH=ex_chat.db

# Redis 缓存与队列
REDIS_PASSWORD=replace-with-a-strong-random-password
REDIS_URL=redis://:replace-with-a-strong-random-password@localhost:6379/0

# 安全与认证
# Production/staging: set ENV=production and generate a unique key with openssl rand -hex 32.
# Development only: empty means a random ephemeral key; restarting invalidates sessions.
JWT_SECRET=
# Accepted JWT lifetime: 1 to 720 hours.
JWT_EXPIRATION_HOURS=72
# Google sign-in is disabled unless the expected OAuth client ID is configured.
GOOGLE_CLIENT_ID=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated proxy IP/CIDR allowlist. Leave empty when serving directly.
TRUSTED_PROXIES=

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 超级管理员配置 (多个邮箱以英文逗号分隔)
SUPER_ADMIN_EMAILS=admin@example.com

# Password-reset email frontend base; use your actual HTTPS application origin.
FRONTEND_URL=https://support.example.com

# Verified one-time USD topups. Leave keys empty until operator configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=https://support.example.com/payment/success
PAYMENT_CANCEL_URL=https://support.example.com/payment/cancel
PAYMENT_ALLOWED_RETURN_URLS=https://support.example.com/payment/success,https://support.example.com/payment/cancel

# Phase7 inbound channels. Blank/invalid settings fail closed (HTTP 503).
# Canonical public HTTPS origin only. No path/query, Host/X-Forwarded trust.
CHANNEL_PUBLIC_BASE_URL=
# Base64 of 32 random bytes; keep in deployment secret manager, never commit.
# Persist independently of DB snapshots; changing it disables existing tokens.
CHANNEL_CREDENTIAL_KEY=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Explicit Graph API version, e.g. v25.0; check your app's supported version.
WHATSAPP_API_VERSION=
# Optional; must exactly match the initiating OAuth redirect_uri when used.
WHATSAPP_REDIRECT_URI=

# Phase8 monolith executor ownership. Legacy remains the default.
# durable is an explicit opt-in with reduced action/condition/multiple-rule parity.
# First startup persists a database-wide claim; conflicting modes fail startup.
# Read architecture/automation-monolith-bridge.md before an offline activation.
AUTOMATION_EXECUTION_MODE=legacy

# Outbound WhatsApp Cloud API / Twilio SMS text is opt-in. Only newly captured
# explicit message intents dispatch; historical queued rows are never adopted.
# Verified channel credentials and CHANNEL_PUBLIC_BASE_URL must already exist.
CHANNEL_OUTBOUND_ENABLED=false

# MSG durable ordinary SMTP queue. Explicit opt-in; no historical adoption.
# New transcript/notification msg.email.send.v1 commands use this worker.
# Account REST transcript adoption is separately opted in below.
# Read architecture/ordinary-email-queue.md before deployment configuration.
ORDINARY_EMAIL_WORKER_ENABLED=false
# Account transcript producer; requires Idempotency-Key and worker/global config.
# Inbox routing additionally needs the separate Inbox opt-in below.
ACCOUNT_TRANSCRIPT_QUEUE_ENABLED=false
# Widget uses current signed visitor authority and a separate scoped key.
WIDGET_TRANSCRIPT_QUEUE_ENABLED=false
# New Inbox Account/Widget transcripts only; requires the matching producer flag,
# ordinary worker + valid global SMTP config, and combined-server CHN adapter.
# Admission disable leaves accepted work on its route; worker disable pauses all.
# Standalone module-server has no Inbox adapter and leaves Inbox queue rows alone.
# Read architecture/inbox-transcript-queue.md; legacy Inbox-only behavior remains.
INBOX_TRANSCRIPT_QUEUE_ENABLED=false
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_SENDER_EMAIL=

# Bounded billing-customer initialization and hosted management, not purchases.
# No mode, currency, locale mapping, portal config or return URL is inferred.
# Independent of top-up/webhook settings. Never commit an actual Stripe key.
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_MODE=
BILLING_INSTALLATION_ID=
BILLING_ALLOWED_CURRENCIES=
BILLING_PORTAL_CONFIGURATION_ID=
BILLING_PORTAL_RETURN_URL=
BILLING_ALLOWED_RETURN_URLS=
