# ex-chat 运行环境配置示例
PORT=8080
ENV=development

# 数据库配置（支持 postgres 与 sqlite）
# 本地 Docker PostgreSQL:
DB_DRIVER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-random-password
DB_DSN=host=localhost user=postgres password=replace-with-a-strong-random-password dbname=ex_chat port=55432 sslmode=disable TimeZone=Asia/Shanghai

# SQLite 回退配置:
# DB_DRIVER=sqlite
# DB_PATH=ex_chat.db

# Redis 缓存与队列
REDIS_PASSWORD=replace-with-a-strong-random-password
REDIS_URL=redis://:replace-with-a-strong-random-password@localhost:6379/0

# 安全与认证
JWT_SECRET=ex-chat-production-ready-jwt-secret-key-2026
JWT_EXPIRATION_HOURS=72
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated proxy IP/CIDR allowlist. Leave empty when serving directly.
TRUSTED_PROXIES=

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 超级管理员配置 (多个邮箱以英文逗号分隔)
SUPER_ADMIN_EMAILS=admin@example.com
